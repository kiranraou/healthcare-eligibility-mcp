# ================================================================
#  YOUR KEYS GO HERE
#  1. Copy this file:   cp .env.example .env
#  2. Paste your own keys after the "=" signs below (no quotes).
#  3. Save. .env is git-ignored, so your keys never get uploaded.
#
#  Everything is optional. Without keys, eligibility checks, the
#  worklist and local analytics still work. In the Streamlit app you
#  can also paste keys in the sidebar under "Your API keys" instead.
# ================================================================

# --- Claude (AI agent and "Explain with Claude") ---
# Get a key: https://console.anthropic.com -> API keys -> Create key
# Your account needs API credits (Console -> Billing).
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace: Console -> Workspaces -> workspace ID
ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Databricks (Bronze/Silver/Gold Delta tables) ---
# Free Edition: https://www.databricks.com/learn/free-edition
# SQL Warehouses -> your warehouse -> Connection details
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Settings -> Developer -> Access tokens -> Generate new token
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=eligibility

# Only if Python fails with "self-signed certificate in certificate chain" (HTTPS inspection
# on your network). Export your Mac's trusted certificates and point to the file:
#   (security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain;
#    security find-certificate -a -p /Library/Keychains/System.keychain) > data/macos-trusted-ca.pem
# DATABRICKS_CA_FILE=data/macos-trusted-ca.pem
# SSL_CERT_FILE=/absolute/path/to/data/macos-trusted-ca.pem

# --- Provider submitting the 270 ---
# PROVIDER_NAME=SUNRISE MEDICAL GROUP
# PROVIDER_NPI=1234567893

# --- Local storage and transport ---
# ELIGIBILITY_DB_PATH=data/eligibility.db
# MCP_TRANSPORT=stdio          # or streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
